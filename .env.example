# ==============================
# دیتابیس (Supabase Postgres)
# ==============================
# از Supabase Dashboard > Project Settings > Database بردار
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==============================
# Supabase (برای Storage و/یا Auth کمکی)
# ==============================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# ==============================
# JWT (احراز هویت خودمان)
# ==============================
JWT_SECRET="یک-رشته-تصادفی-طولانی-و-امن"
JWT_EXPIRES_IN="30d"

# ==============================
# OTP Provider — mrotp.ir
# ==============================
MROTP_API_KEY="..."
MROTP_BASE_URL="https://api.mrotp.ir"
MROTP_SENDER_LINE="..."

# ==============================
# هوش مصنوعی
# ==============================
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ==============================
# عمومی
# ==============================
NEXT_PUBLIC_SITE_URL="https://afralawyersclub.ir"
